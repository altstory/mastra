# Copy to .env. Never commit credentials or personal filesystem paths.
# AltFlow Go backend that owns accounts and roles.
ALTFLOW_BACKEND_URL=http://127.0.0.1:8080
ALTFLOW_AUTH_IDENTITY_ENDPOINT=me
ALTFLOW_MODELHUB_API_KEY=
# Optional HTTPS gateway override (loopback HTTP allowed for tests).
# ALTFLOW_MODELHUB_BASE_URL=https://modelhub.altflow.cn/v1
STUDIO_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://127.0.0.1:4111
STUDIO_PORT=4111
# DuckDB memory limit for the local trace store.
# ALTFLOW_TRACE_MEMORY_LIMIT=1GB
# Optional one-time ownership mapping for pre-login local conversations.
# ALTFLOW_LEGACY_OWNER_ID=

# Private per-user file storage. These credentials are server-only.
ALTFLOW_OSS_ACCESS_KEY_ID=
ALTFLOW_OSS_ACCESS_KEY_SECRET=
ALTFLOW_OSS_BUCKET=altflow-harness
ALTFLOW_OSS_REGION=oss-cn-beijing
ALTFLOW_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# Persist this dedicated quota/file ledger alongside OSS blobs.
# ALTFLOW_FILES_DATABASE_URL=file:./data/user-files.db
# ALTFLOW_FILES_DATABASE_AUTH_TOKEN=

# Use one dedicated private OSS prefix per Agent deployment.
# ALTFLOW_BACKUP_PREFIX=altflow-backups/production-agent
# Enable Trace retention and OSS expiration after a restore check.
# ALTFLOW_BACKUP_CLEANUP=false
# ALTFLOW_BACKUP_ARCHIVE_DAYS=90
# ALTFLOW_BACKUP_OSS_WARNING_BYTES=10737418240
# ALTFLOW_BACKUP_DISK_WARNING_BYTES=2147483648
# ALTFLOW_BACKUP_DISK_RESERVE_BYTES=536870912
# ALTFLOW_BACKUP_COMPACT_MEMORY_LIMIT=3GB

# Optional persistent runtime root (databases, workspaces and caches).
# ALTFLOW_RUNTIME_ROOT=/absolute/path/to/altflow-data

# Independent web search; Qwen calls this API without switching chat models.
ALTFLOW_SEARCH_PROVIDER=deepseek
DEEPSEEK_SEARCH_API_KEY=
# Optional endpoint override. Keep the /v1/tools/search path.
# DEEPSEEK_SEARCH_URL=https://api.deepseek.com/v1/tools/search

# Shared only with the Go creator gateway.
ALTFLOW_CREATOR_SHARED_SECRET=
